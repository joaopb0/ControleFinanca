NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173
# Gere localmente: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Obrigatório: substitua por um segredo aleatório; nunca use o exemplo em produção.
JWT_SECRET=
SESSION_TTL_SECONDS=604800
# Em HTTPS com frontend/backend em sites distintos: none (Secure automático em produção).
COOKIE_SAME_SITE=lax
DB_HOST=127.0.0.1
DB_USER=controlefinanca
DB_PASSWORD=
DB_NAME=controle_financa
DB_PORT=3306
# Para MySQL remoto com TLS validado; DB_SSL_CA opcional (conteúdo PEM da CA).
DB_SSL=false
# Apenas no Docker Render: false usa MySQL externo sem iniciar MySQL efêmero.
MYSQL_EMBEDDED=true
# Enriquecimento opcional de estabelecimentos via Brandfetch (https://developers.brandfetch.com)
# Client ID da Brand Search API / Logo API (plano gratuito: 500 mil buscas/mês e 1 milhão de logos/mês).
# Deixe vazio para desativar o enriquecimento externo sem afetar a importação de extratos.
BRANDFETCH_CLIENT_ID=
# Opcional: API Key privada (Bearer) da Brand API para complementar o setor (industry).
# Nunca exponha esta chave no frontend; o plano gratuito da Brand API possui cota única limitada (100 consultas).
BRANDFETCH_API_KEY=
# Controles operacionais opcionais do enriquecimento de marcas (valores padrão seguros).
MERCHANT_ENRICHMENT_TIMEOUT_MS=3000
MERCHANT_ENRICHMENT_CONCURRENCY=4
MERCHANT_ENRICHMENT_CACHE_TTL_MS=86400000
MERCHANT_ENRICHMENT_CACHE_MAX_SIZE=500
