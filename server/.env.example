NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173
# Gere localmente: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Obrigatório: substitua por um segredo aleatório; nunca use o exemplo em produção.
JWT_SECRET=
SESSION_TTL_SECONDS=604800
# Em HTTPS com frontend/backend em sites distintos: none (Secure automático em produção).
COOKIE_SAME_SITE=lax
DB_HOST=127.0.0.1
DB_USER=controlefinanca
DB_PASSWORD=
DB_NAME=controle_financa
DB_PORT=3306
# Para MySQL remoto com TLS validado; DB_SSL_CA opcional (conteúdo PEM da CA).
DB_SSL=false
# Apenas no Docker Render: false usa MySQL externo sem iniciar MySQL efêmero.
MYSQL_EMBEDDED=true
