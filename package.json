{
  "name": "fullstack-app",
  "version": "1.0.0",
  "private": true,
  "description": "Estrutura Profissional Full Stack: React (Vite) + Node.js (Express)",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" --names \"SERVER,CLIENT\" --prefix-colors \"yellow,cyan\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build:client": "npm --prefix client run build",
    "install:all": "npm install && npm --prefix client install && npm --prefix server install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "csv-parser": "^3.2.1",
    "multer": "^2.4.0"
  }
}
